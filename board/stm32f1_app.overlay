#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/stm32f1-pinctrl.h>

&pinctrl {
    tim1_ch1_pwm_out_pa11: tim1_ch1_pwm_out_pa11 {
        pinmux = < 0x33020 >; /* in modules/hal/stm32/dts/st/f1/stm32f103r(8-b)tx-pinctrl.dtsi:756 */
    };
};


&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    oled_display: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        status = "okay";
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
        softreset-on;
        ready-time-ms = <100>;
    };

    mpu6050: mpu6050@68 {
        compatible = "invensense,mpu6050";
        reg = <0x68>;
        status = "okay";
        smplrt-div = <249>;
        /* optional if you use interrupt:
        int-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        */
    };
};

&timers1 {
    st,prescaler = <71>;
};

&timers2 {
    st,prescaler = <71>;
    status = "okay";
    pwm2: pwm
    {
        status = "okay";
        pinctrl-0 = < &tim1_ch1_pwm_out_pa11 >;
        pinctrl-names = "default"; 
    };
};

/ {
    chosen {
        zephyr,display = &oled_display;
    };
    leds {
        compatible = "gpio-leds";
        led1: led1 {
            gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
        };
    };
    aliases {
        motor-1 = &pwm1;
        motor-dir = &led1;
	};
};

